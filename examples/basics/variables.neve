-- Variables / 变量绑定
-- Use `let` to bind values to names in Neve.

-- Simple binding
let x = 42;
println(x);              -- 42

-- Multiple bindings
let a = 10;
let b = 20;
let c = a + b;
println(c);              -- 30

-- Shadowing: new let shadows previous binding
let n = 1;
let n = n + 1;
println(n);              -- 2

-- Compute with bindings
let w = 5;
let h = 3;
let area = w * h;
println(area);           -- 15

-- Bindings are immutable
let price = 100;
let price = 200;         -- OK: new binding shadows old
println(price);          -- 200
