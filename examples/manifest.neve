#!/usr/bin/env neve
-- File manifest generator: list files by extension with content hashes.
-- Usage: manifest.neve [directory] [extension]
-- Example: manifest.neve . .neve
import std.io as io;
import std.list as list;
import std.path as path;
import std.string as string;

fn buildManifest(dir: String, ext: String) -> List<String> effect = {
    let entries = io.readDirEntryPaths(path.fromString(dir));
    let filtered = list.filter(fn(entry) string.endsWith(toString(entry), ext), entries);
    list.map(fn(entry) {
        let name = toString(entry);
        let hash = io.hashFilePath(entry);
        string.join([name, ": ", hash], "")
    }, filtered)
};

let args = io.args();
let dir = match args { [d, ..] -> d, [] -> "." };
let ext = match args { [_, e, ..] -> e, _ -> ".neve" };
buildManifest(dir, ext)
