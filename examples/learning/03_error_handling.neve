enum Result { Ok(Int), Err(String) };

fn safe_div(a: Int, b: Int) -> Result = {
    if b == 0 then Err("division by zero")
    else Ok(a / b)
};

fn divide_or_zero(a: Int, b: Int) -> Int = match safe_div(a, b) {
    Ok(v) -> v,
    Err(_) -> 0
};

let ok = safe_div(10, 2);
let err = safe_div(10, 0);
let def = divide_or_zero(10, 0);
