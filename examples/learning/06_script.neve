#!/usr/bin/env neve run
import std.io as io;

fn main() effect = {
    let (args, _) = io.args();
    let name = match args {
        [n, ..] -> n,
        [] -> "World"
    };
    io.println("Hello, " ++ name ++ "!");
    let files = io.glob("*.neve");
    let count = len(files);
    io.println("Found " ++ toString(count) ++ " .neve files");
    0
};
