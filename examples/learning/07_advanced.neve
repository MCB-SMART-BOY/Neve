use std.list as list

complete(t: _) = { title = t.title, done = true }

is_done(t: _) = t.done

summarize(tasks: _) = {
  let done_count = len(list.filter(is_done, tasks));
  "Tasks: " ++ toString(done_count) ++ "/" ++ toString(len(tasks)) ++ " done"
}

tasks = [{ title = "Learn Neve", done = true }, { title = "Build project", done = false }]

r = summarize(tasks)
