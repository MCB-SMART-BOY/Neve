addOne = |x| {
  x + 1
}

println(addOne(41));

add = |a, b| {
  a + b
}

println(add(10, 20));

println(|x| {
  x * x
}(7));

makeAdder = |n| {
  |x| {
    x + n
  }
}

add5 = makeAdder(5)

add10 = makeAdder(10)

println(add5(3));

println(add10(3));

apply = |f, x| {
  f(x)
}

double = |x| {
  x * 2
}
