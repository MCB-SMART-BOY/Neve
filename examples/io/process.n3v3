use std.io = io

result = io.execCommand(io.command("echo", ["hello world"]))

println(io.processSuccess(result));

println(io.processStdout(result));

cmd = io.commandWith({ program = "cat", args = [], stdin = "input from n3v3" })

result = io.execCommand(cmd)

println(io.processStdout(result));

pipeline = io.pipeline([io.command("echo", ["n3v3 is great"]), io.command("wc", ["-w"])])

result = io.execPipeline(pipeline)

println(io.processStdout(result));

result = io.execCommand(io.command("test", ["-f", "/etc/hosts"]))

println(io.processCode(result));

result = io.execCommand(io.command("ls", ["/nonexistent"]))
