io.writeFile("/tmp/neve-example.txt", "Hello from Neve!\n");

content = io.readFile("/tmp/neve-example.txt")

println(content);

io.appendFile("/tmp/neve-example.txt", "Second line\n");

lines = io.lines("/tmp/neve-example.txt")

println(lines);

println(io.pathExists("/tmp/neve-example.txt"));

println(io.pathExists("/tmp/does-not-exist"));

io.createDirAll("/tmp/neve-demo/nested");

io.writeFile("/tmp/neve-demo/nested/data.txt", "nested file");

entries = io.readDir("/tmp/neve-demo")

println(entries);
