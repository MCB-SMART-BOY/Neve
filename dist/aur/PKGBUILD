# Maintainer: MCB-SMART-BOY <mcb@neve-lang.org>
# Contributor: n3v3 Language Team

pkgname=n3v3
pkgver=3.18.0
pkgrel=1
pkgdesc="A typed systems automation language — config, build, monitor, script (v3.0 syntax)"
arch=('x86_64' 'aarch64')
url="https://github.com/MCB-SMART-BOY/n3v3"
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('cargo' 'git')
optdepends=('lean4: formal verification')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/n3v3-$pkgver"
    cargo build --release --locked -p n3v3
}

check() {
    cd "$srcdir/n3v3-$pkgver"
    cargo test --workspace --locked
}

package() {
    cd "$srcdir/n3v3-$pkgver"
    install -Dm755 target/release/n3v3 "$pkgdir/usr/bin/n3v3"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
