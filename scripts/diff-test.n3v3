#!/usr/bin/env n3v3 run
-- Differential test: compare basic expressions
-- 差分测试：比较基础表达式
-- Usage: n3v3 run scripts/diff-test.n3v3
use std.io = io;

let runTest = fn(expr, expected) {
    io.print("  " ++ expr ++ " = " ++ expected ++ " ... ");

    -- Evaluate with n3v3
    let n3v3_cmd = io.command("n3v3", ["eval", expr]);
    let n3v3_result = io.execCommand(n3v3_cmd);
    let actual = io.processStdout(n3v3_result);

    if actual == expected -> {
        io.println("PASS");
        true
    } else {
        io.println("FAIL (got=" ++ actual ++ ")");
        false
    }
};

io.println("=== Differential Test: n3v3 Evaluator ===");

-- Arithmetic
let r1 = runTest("1 + 2", "3");
let r2 = runTest("(3 + 4) * 2", "14");

-- Boolean
let r3 = runTest("1 == 1", "true");
let r4 = runTest("1 == 2", "false");

-- Count results (convert bools to ints and sum)
let toInt = fn(b) { if b -> 1 else 0 };
let passed = toInt(r1) + toInt(r2) + toInt(r3) + toInt(r4);
let failed = 4 - passed;

io.println("");
io.println("Results: " ++ toString(passed) ++ " passed, " ++ toString(failed) ++ " failed");

if failed > 0 -> 1 else 0
