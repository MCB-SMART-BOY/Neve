%YAML 1.2
---
# Neve v3.0 syntax highlighting for Sublime Text / VS Code / Helix
name: Neve
scope: source.neve
file_extensions: [neve]

contexts:
  main:
    - match: '--.*'
      scope: comment.line.neve

    # Keywords (v3.0: 9 keywords)
    - match: \b(if|then|else|match|use|as|type|trait|impl|pub|effect|lazy)\b
      scope: keyword.control.neve

    # Boolean literals
    - match: \b(true|false)\b
      scope: constant.language.neve

    # Builtin types
    - match: \b(Int|Float|Bool|String|Char|Unit|List|Record|Option|Result|Path|Bytes|Command|Pipeline|ProcessResult|Stream|Task|Job)\b
      scope: storage.type.neve

    # Numbers
    - match: \b[0-9][0-9_]*(\.[0-9]+)?\b
      scope: constant.numeric.neve

    # Operators (v3.0: & replaces //)
    - match: '(\+|\-|\*|\/|\%|\^|==|!=|<=|>=|<|>|&&|\|\||\+\+|&|\?\?|\?\.|\|>|->|=>|\!|=)'
      scope: keyword.operator.neve

    # Punctuation / delimiters
    - match: '[(){}\[\],;:\.@]'
      scope: punctuation.neve

    # Strings
    - match: '"'
      push: string

    # Characters
    - match: "'"
      push: char

    # Interpolated strings
    - match: '`'
      push: interpolation

    # Path literals
    - match: '(\.\/|\.\.\/|\/)[a-zA-Z0-9_\-\.\/]+'
      scope: string.unquoted.neve

  string:
    - meta_scope: string.quoted.double.neve
    - match: '\\.'
      scope: constant.character.escape.neve
    - match: '"'
      pop: true

  char:
    - meta_scope: string.quoted.single.neve
    - match: '\\.'
      scope: constant.character.escape.neve
    - match: "'"
      pop: true

  interpolation:
    - meta_scope: string.interpolated.neve
    - match: '\{'
      push: interpolation_expr
    - match: '`'
      pop: true

  interpolation_expr:
    - meta_scope: string.interpolated.neve
    - match: '\}'
      pop: true
    - include: main
