#[test]
fn test_end_to_end_stream_lines_from_file() {
    // Write temp file with 3 lines, use io.streamLines + io.streamCollect, verify content.
    let temp = TempDir::new().expect("temp dir");
    let test_path = temp.path().join("stream-lines-test.txt");
    std::fs::write(&test_path, "line1\nline2\nline3\n").unwrap();
    let escaped = test_path.to_string_lossy().replace('\\', "\\\\");
    assert_runtime_parity(
        &format!(
            r#"
import std.io as io;
let s = io.streamLines("{escaped}");
let result = io.streamCollect(s);
let x = result == ["line1", "line2", "line3"];
"#
        ),
        Value::Bool(true),
    );
}

#[test]
fn test_end_to_end_stream_command_echo() {
    // io.streamCommand(io.command("echo", ["hello"])) + io.streamCollect returns ["hello"].
    assert_runtime_parity(
        r#"
import std.io as io;
let cmd = io.command("echo", ["hello"]);
let s = io.streamCommand(cmd);
let result = io.streamCollect(s);
let x = result == ["hello"];
"#,
        Value::Bool(true),
    );
}

