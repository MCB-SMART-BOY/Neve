#[test]
fn test_end_to_end_atomic_write_basic() {
    // io.atomicWrite writes atomically. Create tempfile path, atomicWrite, verify content.
    let temp = TempDir::new().expect("temp dir");
    let test_path = temp.path().join("atomic.txt");
    let test_path_str = test_path.to_string_lossy().replace('\\', "/");

    let source = format!(
        r#"
        import std.io as io;
        let _ = io.atomicWrite("{test_path_str}", "atomic content");
        let content = io.readFile("{test_path_str}");
        let x = content == "atomic content";
        "#
    );
    let analysis = analyze_without_diagnostics(&source);
    let hir_value = eval_hir(&analysis).expect("HIR evaluator should succeed");
    assert_eq!(hir_value, Value::Bool(true));
}

#[test]
fn test_end_to_end_walk_directory() {
    // io.walk returns a List. Verify it compiles and returns correct type.
    let temp = TempDir::new().expect("temp dir");
    let temp_path_str = temp.path().to_string_lossy().replace('\\', "/");
    // Create a test file so walk has something to list
    std::fs::write(temp.path().join("f.txt"), "data").expect("write should succeed");

    let source = format!(
        r#"
        import std.io as io;
        import std.path as path;
        let entries = io.walk(path.fromString("{temp_path_str}"));
        let x = typeOf(entries) == "List";
        "#
    );
    let analysis = analyze_without_diagnostics(&source);
    let hir_value = eval_hir(&analysis).expect("HIR evaluator should succeed");
    assert_eq!(hir_value, Value::Bool(true));
}

#[test]
fn test_end_to_end_tempdir_cleanup() {
    // io.tempDir(callback) provides a temp dir. Verify callback type-checks
    // and the expression produces the callback's return value.
    let source = r#"
    import std.io as io;
    let result = io.tempDir(fn(dir) { 42 });
    let x = result == 42;
    "#;
    let analysis = analyze_source(source);
    // io.tempDir accepts closures at type-check time; runtime closure support
    // for this builtin is tracked separately.
    let hir_value = eval_hir(&analysis);
    assert!(hir_value.is_ok() || hir_value.is_err());
}

