// ============================================================
// Redirect boundary tests (Phase 4 additions)
// ============================================================

#[test]
fn test_end_to_end_redirect_stdout_stderr_simultaneous() {
    // A command with both stdout and stderr redirects should work.
    let temp = TempDir::new().expect("temp dir should exist");
    let stdout_path = temp.path().join("stdout.txt");
    let stderr_path = temp.path().join("stderr.txt");
    let stdout_path_source = stdout_path.to_string_lossy().replace('\\', "\\\\");
    let stderr_path_source = stderr_path.to_string_lossy().replace('\\', "\\\\");
    let source = if cfg!(windows) {
        format!(
            r#"
        import std.io as io;
        import std.path as path;
        let out = path.fromString("{stdout_path_source}");
        let err = path.fromString("{stderr_path_source}");
        let result = io.execCommand(
            io.commandWithRedirects(
                io.command("cmd", ["/C", "echo stdout && echo stderr >&2"]),
                [io.redirectStdoutPath(out), io.redirectStderrPath(err)]
            )
        );
        let redirected_out = io.readFilePath(out);
        let redirected_err = io.readFilePath(err);
        let x =
            typeOf(result) == "ProcessResult" &&
            io.processSuccess(result) &&
            io.processStdout(result) == "" &&
            io.processStderr(result) == "" &&
            redirected_out != "" &&
            redirected_err != "";
        "#
        )
    } else {
        format!(
            r#"
        import std.io as io;
        import std.path as path;
        let out = path.fromString("{stdout_path_source}");
        let err = path.fromString("{stderr_path_source}");
        let result = io.execCommand(
            io.commandWithRedirects(
                io.command("sh", ["-c", "echo stdout; echo stderr >&2"]),
                [io.redirectStdoutPath(out), io.redirectStderrPath(err)]
            )
        );
        let redirected_out = io.readFilePath(out);
        let redirected_err = io.readFilePath(err);
        let x =
            typeOf(result) == "ProcessResult" &&
            io.processSuccess(result) &&
            io.processStdout(result) == "" &&
            io.processStderr(result) == "" &&
            redirected_out != "" &&
            redirected_err != "";
        "#
        )
    };
    let analysis = analyze_without_diagnostics(&source);
    let ast_value = eval_ast(&analysis).expect("AST evaluator should succeed");
    let hir_value = eval_hir(&analysis).expect("HIR evaluator should succeed");
    assert_eq!(ast_value, Value::Bool(true));
    assert_eq!(hir_value, Value::Bool(true));
}

#[test]
fn test_end_to_end_redirect_stdin_from_file() {
    // A command with stdin redirected from a file should work.
    let temp = TempDir::new().expect("temp dir should exist");
    let stdin_path = temp.path().join("stdin.txt");
    fs::write(&stdin_path, "hello stdin\n").expect("stdin file should be writable");
    let stdin_path_source = stdin_path.to_string_lossy().replace('\\', "\\\\");
    let source = if cfg!(windows) {
        format!(
            r#"
        import std.io as io;
        import std.path as path;
        let input = path.fromString("{stdin_path_source}");
        let result = io.execCommand(
            io.commandWithRedirects(
                io.command("cmd", ["/C", "findstr hello"]),
                [io.redirectStdinPath(input)]
            )
        );
        let x =
            typeOf(result) == "ProcessResult" &&
            io.processSuccess(result) &&
            io.processStdout(result) != "";
        "#
        )
    } else {
        format!(
            r#"
        import std.io as io;
        import std.path as path;
        let input = path.fromString("{stdin_path_source}");
        let result = io.execCommand(
            io.commandWithRedirects(
                io.command("cat", []),
                [io.redirectStdinPath(input)]
            )
        );
        let x =
            typeOf(result) == "ProcessResult" &&
            io.processSuccess(result) &&
            io.processStdout(result) != "";
        "#
        )
    };
    let analysis = analyze_without_diagnostics(&source);
    let ast_value = eval_ast(&analysis).expect("AST evaluator should succeed");
    let hir_value = eval_hir(&analysis).expect("HIR evaluator should succeed");
    assert_eq!(ast_value, Value::Bool(true));
    assert_eq!(hir_value, Value::Bool(true));
}

#[test]
fn test_end_to_end_command_with_redirects_constructs() {
    // io.commandWithRedirects creates a Command with redirects attached.
    assert_runtime_parity(
        r#"
        import std.io as io;
        import std.path as path;
        let cmd = io.commandWithRedirects(
            io.command("echo", ["hello"]),
            [io.redirectStdoutPath(path.fromString("/tmp/out.txt"))]
        );
        let x = typeOf(cmd) == "Command";
        "#,
        Value::Bool(true),
    );
}

