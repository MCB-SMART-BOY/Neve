// -- List rest pattern in match --
#[test]
fn test_end_to_end_list_rest_match_exhaustiveness() {
    let analysis = neve_frontend::analyze_source(
        r#"
        let x = match [1, 2, 3] {
            [] -> 0,
            [first, ..rest] -> first + 1,
        };
        "#,
    );
    let has_exhaustive_error = analysis
        .diagnostics
        .iter()
        .any(|d| d.message.contains("non-exhaustive"));
