import std.io as io;
let t = io.taskCommand(io.command("echo", ["hello"]));
let x = typeOf(t) == "Task";
"#,
        Value::Bool(true),
    );
}

#[test]
fn test_end_to_end_type_of_bytes_returns_bytes() {
