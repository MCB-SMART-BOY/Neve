#[test]
fn test_end_to_end_stream_pipe_is_effectful() {
    // Verify that io.streamPipe is recognized as effectful.
    let analysis = neve_frontend::analyze_source(
        r#"
import std.io as io;
fn bad() -> ProcessResult = io.streamPipe(
    io.streamList(["data"]),
    io.command("cat", [])
);
"#,
    );
    let has_effect_error = analysis
        .diagnostics
        .iter()
        .any(|d| d.message.contains("effect") || d.message.contains("effectful"));
    assert!(
        has_effect_error,
        "expected effect error for io.streamPipe, got {:?}",
        analysis.diagnostics
    );
}

