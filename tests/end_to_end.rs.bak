}

#[test]
fn test_end_to_end_poll_rejects_non_int() {
    // io.poll on a String should produce a type error.
    let analysis = neve_frontend::analyze_source(
        r#"
import std.io as io;
let x = io.poll("not_an_int");
"#,
    );
    assert!(
        analysis
            .diagnostics
            .iter()
            .any(|d| d.message.contains("type mismatch")),
        "expected type mismatch error, got {:?}",
        analysis.diagnostics
    );
}

#[test]
fn test_end_to_end_await_any_rejects_non_list() {
    // io.awaitAny on an Int should produce a type error.
    let analysis = neve_frontend::analyze_source(
        r#"
import std.io as io;
let x = io.awaitAny(123);
"#,
    );
    assert!(
        analysis
            .diagnostics
            .iter()
            .any(|d| d.message.contains("type mismatch")),
        "expected type mismatch error, got {:?}",
        analysis.diagnostics
    );
}

#[test]
fn test_end_to_end_command_with_cwd_and_env_isolation() {
    // Verify that io.commandWith with cwd and env correctly executes.
    // Use pwd to verify cwd, and printenv to verify env.
    let source = r#"
        import std.io as io;
        let cmd = io.commandWith(#{
            program = "sh",
            args = ["-c", "echo $TEST_VAR"],
            cwd = "/tmp",
            env = #{TEST_VAR = "neve-isolation-value"},
        });
        let result = io.execCommand(cmd);
        let stdout = io.processStdout(result);
        let x = stdout == "neve-isolation-value\n";
    "#;
    let analysis = analyze_without_diagnostics(source);
    let ast_value = eval_ast(&analysis).expect("AST evaluator should succeed");
    let hir_value = eval_hir(&analysis).expect("HIR evaluator should succeed");
    assert_eq!(ast_value, Value::Bool(true));
    assert_eq!(hir_value, Value::Bool(true));
}

// ============================================================================
// Pipe/redirect edge cases (5 tests)
// ============================================================================

#[test]
fn test_end_to_end_pipeline_with_no_commands_errors_v2() {
    // io.pipeline with an empty list should produce a runtime error.
    assert_runtime_error_parity(
        r#"
import std.io as io;
let x = io.pipeline([]);
"#,
        "requires a non-empty List<Command>",
    );
}

#[test]
fn test_end_to_end_redirect_with_invalid_type_errors() {
    // io.redirectStdoutPath on an Int (not a Path) should produce a type error.
    let analysis = neve_frontend::analyze_source(
        r#"
import std.io as io;
let x = io.redirectStdoutPath(42);
"#,
    );
    assert!(
        analysis
            .diagnostics
            .iter()
            .any(|d| d.message.contains("type mismatch")),
        "expected type mismatch error, got {:?}",
        analysis.diagnostics
    );
}

#[test]
fn test_end_to_end_command_with_redirects_type_identity_v2() {
    // io.commandWithRedirects returns a Command.
    assert_runtime_parity(
        r#"
import std.io as io;
import std.path as path;
let cmd = io.commandWithRedirects(
    io.command("echo", ["hello"]),
    [io.redirectStdoutPath(path.fromString("/tmp/out2.txt"))]
);
let x = typeOf(cmd) == "Command";
"#,
        Value::Bool(true),
    );
}

#[test]
fn test_end_to_end_pipeline_with_redirects_type_identity_v2() {
    // io.pipelineWithRedirects returns a Pipeline.
    assert_runtime_parity(
        r#"
import std.io as io;
import std.path as path;
let pipe = io.pipelineWithRedirects(
    io.pipeline([io.command("printf", ["neve"]), io.command("cat", [])]),
    [io.redirectStdoutPath(path.fromString("/tmp/neve2.out"))]
);
let x = typeOf(pipe) == "Pipeline";
"#,
        Value::Bool(true),
    );
}

#[test]
fn test_end_to_end_pipe_chain_with_mixed_types_errors() {
    // Piping a Command into an Int (non-Command) should produce a type error.
    let analysis = neve_frontend::analyze_source(
        r#"
import std.io as io;
let cmd = io.command("echo", ["hello"]);
let x = cmd |> 42;
"#,
    );
    assert!(
        analysis
            .diagnostics
            .iter()
            .any(|d| d.message.contains("pipe: right side must be a Command")),
        "expected pipe type error, got {:?}",
        analysis.diagnostics
    );
}

