// === Command pipe syntax tests (cmd1 |> cmd2) ===

#[test]
fn test_end_to_end_command_pipe_creates_pipeline() {
    assert_runtime_parity(
        r#"
    import std.io as io;
    let cmd1 = io.command("echo", ["hello"]);
    let cmd2 = io.command("cat", []);
    let pipeline = cmd1 |> cmd2;
    let x = typeOf(pipeline) == "Pipeline";
    "#,
        Value::Bool(true),
    );
}

#[test]
fn test_end_to_end_command_pipe_executes() {
    // Effectful: verify both AST and HIR paths succeed
    let source = r#"
    import std.io as io;
    let cmd1 = io.command("echo", ["hello pipe"]);
    let cmd2 = io.command("cat", []);
    let pipeline = cmd1 |> cmd2;
    let result = io.execPipeline(pipeline);
    let x = io.processSuccess(result);
    "#;
    let analysis = analyze_without_diagnostics(source);
    let ast_value = eval_ast(&analysis).expect("AST evaluator should succeed");
    let hir_value = eval_hir(&analysis).expect("HIR evaluator should succeed");
    assert_eq!(ast_value, Value::Bool(true), "AST pipe exec failed");
    assert_eq!(hir_value, Value::Bool(true), "HIR pipe exec failed");
}

#[test]
fn test_end_to_end_pipe_command_to_noncommand_errors() {
    // Type checker catches this before evaluation
    let analysis = analyze_source(
        r#"
    import std.io as io;
    let cmd = io.command("echo", ["hello"]);
    let x = cmd |> 42;
    "#,
    );
    assert!(
        analysis
            .diagnostics
            .iter()
            .any(|d| d.message.contains("pipe: right side must be a Command")),
        "expected pipe type error, got {:?}",
        analysis.diagnostics
    );
}

#[test]
fn test_end_to_end_pipe_pipeline_to_noncommand_errors() {
    // Type checker catches this before evaluation
    let analysis = analyze_source(
        r#"
    import std.io as io;
    let p = io.command("echo", ["a"]) |> io.command("cat", []);
    let x = p |> 42;
    "#,
    );
    assert!(
        analysis
            .diagnostics
            .iter()
            .any(|d| d.message.contains("pipe: right side must be a Command")),
        "expected pipe type error, got {:?}",
        analysis.diagnostics
    );
}

#[test]
fn test_end_to_end_pipe_three_commands_creates_pipeline_of_three() {
    assert_runtime_parity(
        r#"
    import std.io as io;
    let p = io.command("echo", ["a"]) |> io.command("cat", []) |> io.command("wc", ["-l"]);
    let x = typeOf(p) == "Pipeline";
    "#,
        Value::Bool(true),
    );
}

#[test]
fn test_end_to_end_function_pipe_still_works() {
