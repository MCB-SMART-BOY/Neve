#[test]
fn test_end_to_end_streaming_callback_applied() {
    // io.execCommandStreaming with a callback that counts lines.
    // Effectful; evaluator-owned builtin (HIR evaluator only).
    let source = r#"
    import std.io as io;
    fn countLines(line) effect = ();
    let cmd = io.command("echo", ["line1\nline2\nline3"]);
    let result = io.execCommandStreaming(cmd, countLines);
    let x = typeOf(result) == "ProcessResult";
    "#;
    let analysis = analyze_without_diagnostics(source);
    let hir_value = eval_hir(&analysis).expect("HIR evaluator should succeed");
    assert_eq!(hir_value, Value::Bool(true));
}

#[test]
fn test_end_to_end_streaming_file_lines() {
    // io.readFileLines reads a file line by line and invokes callback.
    let temp = TempDir::new().expect("temp dir");
    let test_path = temp.path().join("streaming-lines.txt");
    let test_path_str = test_path.to_string_lossy().replace('\\', "/");
    std::fs::write(&test_path, "alpha\nbeta\ngamma\n").expect("write should succeed");

    let source = format!(
        r#"
        import std.io as io;
        let _ = io.readFileLines("{test_path_str}", fn(line) {{ () }});
        let x = true;
        "#
    );
    let analysis = analyze_without_diagnostics(&source);
    let hir_value = eval_hir(&analysis).expect("HIR evaluator should succeed");
    assert_eq!(hir_value, Value::Bool(true));
}

#[test]
fn test_end_to_end_streaming_max_lines_limit() {
    // Test that a 5-line echo works via streaming (modest line count).
    let source = r#"
    import std.io as io;
    let cmd = io.command("sh", ["-c", "printf 'line1\nline2\nline3\nline4\nline5\n'"]);
    let result = io.execCommandStreaming(cmd, fn(line) { () });
    let x = typeOf(result) == "ProcessResult" && io.processSuccess(result);
    "#;
    let analysis = analyze_without_diagnostics(source);
    let hir_value = eval_hir(&analysis).expect("HIR evaluator should succeed");
    assert_eq!(hir_value, Value::Bool(true));
}

#[test]
fn test_end_to_end_streaming_pipeline_timeout_completes() {
    // io.execPipelineStreamingWithTimeout with a fast pipeline + 5s timeout
    // completes normally returning Some(ProcessResult).
    let source = r#"
    import std.io as io;
    let pipeline = io.pipeline([
        io.command("echo", ["hello streaming timeout"]),
        io.command("cat", [])
    ]);
    let result = io.execPipelineStreamingWithTimeout(pipeline, fn(line) { () }, 5000);
    let x = match result {
        Some(r) -> typeOf(r) == "ProcessResult",
        None -> false
    };
    "#;
    let analysis = analyze_without_diagnostics(source);
    let hir_value = eval_hir(&analysis).expect("HIR evaluator should succeed");
    assert_eq!(hir_value, Value::Bool(true));
}

