    assert_runtime_parity(
        r#"
import std.path as path;
let p = path.fromString("/tmp/test");
let x = typeOf(p) == "Path";
"#,
        Value::Bool(true),
    );
}

// ============================================================================
// Pattern matching tests (4 tests)
// ============================================================================

#[test]
fn test_end_to_end_match_option_some_with_binding() {
    // match on Option::Some should bind the inner value.
    assert_runtime_parity(
        r#"
import std.option as option;
let x = match option.some(42) {
    Some(n) -> n,
    None -> 0,
};
"#,
        Value::Int(int(42)),
    );
}

#[test]
fn test_end_to_end_match_result_ok_with_binding() {
    // match on Result::Ok should bind the inner value.
    assert_runtime_parity(
        r#"
import std.result as result;
let x = match result.ok(7) {
    Ok(val) -> val,
    Err(_) -> -1,
};
"#,
        Value::Int(int(7)),
    );
}

#[test]
fn test_end_to_end_match_list_empty_and_non_empty() {
    // match on a List with [] and [head, ..] patterns.
    assert_runtime_parity(
        r#"
let x = match [1, 2, 3] {
    [] -> -1,
    [head, ..] -> head,
};
"#,
        Value::Int(int(1)),
    );
}

#[test]
fn test_end_to_end_match_int_with_range_guards() {
    // match on Int with if-guards simulating ranges.
    assert_runtime_parity(
        r#"
let x = match 25 {
    n if n < 0 -> "negative",
    n if n >= 0 && n < 10 -> "small",
    n if n >= 10 && n < 100 -> "medium",
    _ -> "large",
};
"#,
        Value::String("medium".to_string().into()),
    );
}

// ============================================================================
// Lazy evaluation tests (3 tests)
// ============================================================================

#[test]
fn test_end_to_end_lazy_simple_expression() {
    // lazy creates a thunk that is not evaluated until forced.
    assert_runtime_parity(
        r#"
let thunk = lazy (21 + 21);
let x = force(thunk);
"#,
        Value::Int(int(42)),
    );
}

#[test]
fn test_end_to_end_force_evaluates_lazy() {
    // force on a lazy thunk should compute and return the value.
    assert_runtime_parity(
        r#"
let thunk = lazy (10 * 5);
let x = force(thunk) == 50;
"#,
        Value::Bool(true),
    );
}

#[test]
fn test_end_to_end_is_evaluated_on_forced_lazy_returns_true() {
    // After forcing a lazy thunk, isEvaluated should return true.
    assert_runtime_parity(
        r#"
let thunk = lazy 99;
let _ = force(thunk);
let x = isEvaluated(thunk);
"#,
        Value::Bool(true),
    );
}

// ============================================================================
// Effect system tests (2 tests)
// ============================================================================

#[test]
fn test_end_to_end_pure_function_cannot_call_effectful_builtin() {
    // A function without the `effect` keyword should be rejected
    // when calling an effectful builtin like io.execCommand.
    let analysis = neve_frontend::analyze_source(
        r#"
import std.io as io;
fn bad() -> ProcessResult = io.execCommand(io.command("echo", ["hello"]));
"#,
    );
    let has_effect_error = analysis
        .diagnostics
        .iter()
        .any(|d| d.message.contains("effectful call") && d.message.contains("effect"));
    assert!(
        has_effect_error,
        "pure function should reject effectful builtin, got {:?}",
        analysis.diagnostics
    );
}

#[test]
fn test_end_to_end_effectful_function_can_call_pure_builtin() {
    // A function with the `effect` keyword should be allowed to call
    // pure builtins like math functions.
    let analysis = neve_frontend::analyze_source(
        r#"
import std.math as math;
fn ok() -> Int effect = math.abs(-5);
"#,
    );
    let has_effect_error = analysis
        .diagnostics
        .iter()
        .any(|d| d.message.contains("effectful call"));
    assert!(
        !has_effect_error,
        "effectful function should be able to call pure builtins, got {:?}",
        analysis.diagnostics
    );
}

#[test]
fn test_end_to_end_jobs_empty_when_none() {
    // io.jobs() returns a List even when no tasks are spawned.
    // Note: cannot assert list emptiness in parallel test execution due to global registry.
    assert_runtime_parity(
        r#"
import std.io as io;
let jobs = io.jobs();
let x = typeOf(jobs) == "List";
"#,
        Value::Bool(true),
    );
}

#[test]
fn test_end_to_end_jobs_lists_active() {
    // Spawn a task, call io.jobs(), verify returns a list with at least 1 job.
    let source = r#"
import std.io as io;
let cmd = io.command("sleep", ["10"]);
let task = io.taskCommand(cmd);
let _id = io.spawn(task);
let jobs = io.jobs();
let x = typeOf(jobs) == "List" && len(jobs) >= 1;
"#;
    let analysis = analyze_without_diagnostics(source);
    let hir_value = eval_hir(&analysis).expect("HIR evaluator should succeed");
    assert_eq!(hir_value, Value::Bool(true));
}

#[test]
fn test_end_to_end_wait_any_job_returns_result() {
    // Spawn two tasks, call io.waitAnyJob(), verify returns a Record with id and result.
    let source = r#"
import std.io as io;
let _id1 = io.spawn(io.taskCommand(io.command("echo", ["fast"])));
let _id2 = io.spawn(io.taskCommand(io.command("echo", ["also-fast"])));
let result = io.waitAnyJob();
let x = typeOf(result) == "Record";
"#;
    let analysis = analyze_without_diagnostics(source);
    let hir_value = eval_hir(&analysis).expect("HIR evaluator should succeed");
    assert_eq!(hir_value, Value::Bool(true));
}
