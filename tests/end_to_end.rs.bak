// ============================================================
// Task spawn/poll lifecycle tests
// ============================================================

#[test]
fn test_end_to_end_task_spawn_poll_running_done() {
    // Spawn a task, poll in a loop until it returns Some, verify done is true.
    let source = r#"
        import std.io as io;
        let cmd = io.command("echo", ["hello task"]);
        let task = io.taskCommand(cmd);
        let id = io.spawn(task);
        fn pollUntilDone(id) effect = match io.poll(id) {
            Some(pr) -> pr,
            None -> pollUntilDone(id)
        };
        let result = pollUntilDone(id);
        let x = io.processSuccess(result);
    "#;
    let analysis = analyze_without_diagnostics(source);
    let ast_value = eval_ast(&analysis).expect("AST evaluator should succeed");
    let hir_value = eval_hir(&analysis).expect("HIR evaluator should succeed");
    assert_eq!(ast_value, Value::Bool(true));
    assert_eq!(hir_value, Value::Bool(true));
}

#[test]
fn test_end_to_end_task_spawn_with_timeout_completes() {
    // SpawnWithTimeout with a long timeout for echo; poll until done, verify processSuccess.
    let source = r#"
        import std.io as io;
        let cmd = io.command("echo", ["hello"]);
        let task = io.taskCommand(cmd);
        let id = io.spawnWithTimeout(task, 5000);
        fn pollUntilDone(id) effect = match io.poll(id) {
            Some(pr) -> pr,
            None -> pollUntilDone(id)
        };
        let result = pollUntilDone(id);
        let x = io.processSuccess(result);
    "#;
    let analysis = analyze_without_diagnostics(source);
    let ast_value = eval_ast(&analysis).expect("AST evaluator should succeed");
    let hir_value = eval_hir(&analysis).expect("HIR evaluator should succeed");
    assert_eq!(ast_value, Value::Bool(true));
    assert_eq!(hir_value, Value::Bool(true));
}
#[test]
fn test_end_to_end_task_spawn_with_timeout_expires() {
    // SpawnWithTimeout with a short timeout for sleep 10; poll returns None (task still running).
    let source = r#"
        import std.io as io;
        let task = io.taskCommand(io.command("sleep", ["10"]));
        let id = io.spawnWithTimeout(task, 100);
        let result = io.poll(id);
        let x = match result {
            Some(pr) -> false,
            None -> true
        };
    "#;
    let analysis = analyze_without_diagnostics(source);
    let ast_value = eval_ast(&analysis).expect("AST evaluator should succeed");
    let hir_value = eval_hir(&analysis).expect("HIR evaluator should succeed");
    assert_eq!(ast_value, Value::Bool(true));
    assert_eq!(hir_value, Value::Bool(true));
}

#[test]
fn test_end_to_end_task_poll_invalid_id_returns_error() {
    // Polling a never-spawned ID should error with "no task with ID".
    // Check both AST and HIR paths.
    assert_runtime_error_parity(
        r#"
        import std.io as io;
        let x = io.poll(99999);
        "#,
        "no task with ID",
    );
}

#[test]
fn test_end_to_end_task_spawn_pipeline() {
    // Spawn a pipeline task, poll until done, verify processSuccess.
    let source = r#"
        import std.io as io;
        let pipeline = io.command("echo", ["hello"]) |> io.command("cat", []);
        let task = io.taskPipeline(pipeline);
        let id = io.spawn(task);
        fn pollUntilDone(id) effect = match io.poll(id) {
            Some(pr) -> pr,
            None -> pollUntilDone(id)
        };
        let result = pollUntilDone(id);
        let x = io.processSuccess(result);
    "#;
    let analysis = analyze_without_diagnostics(source);
    let ast_value = eval_ast(&analysis).expect("AST evaluator should succeed");
    let hir_value = eval_hir(&analysis).expect("HIR evaluator should succeed");
    assert_eq!(ast_value, Value::Bool(true));
    assert_eq!(hir_value, Value::Bool(true));
}

#[test]
fn test_end_to_end_await_tasks_multiple() {
    // awaitTasks returns a list of length 2 for two tasks.
    assert_runtime_parity(
        r#"
        import std.io as io;
        let results = io.awaitTasks([
            io.taskCommand(io.command("echo", ["hello"])),
            io.taskCommand(io.command("echo", ["world"]))
        ]);
        match results {
            [_, _] -> true,
            _ -> false
        }
        "#,
        Value::Bool(true),
    );
}

// ============================================================
// Signal handling tests (Phase 4 additions)
// ============================================================

#[test]
fn test_end_to_end_signal_handler_registration_parity() {
    // Register a signal handler via io.onSignal and verify it typechecks and runs.
    // Uses a pure callback so the handler is merely stored.
    let source = r#"
        import std.io as io;
        let _ = io.onSignal("INT", fn() { () });
        let x = true;
    "#;
    let analysis = analyze_without_diagnostics(source);
    let hir_value = eval_hir(&analysis).expect("HIR evaluator should succeed");
    assert_eq!(hir_value, Value::Bool(true));
}

#[test]
fn test_end_to_end_signal_handler_rejects_invalid_signal() {
    // io.onSignal with an unknown signal name should produce an error.
    let source = r#"
        import std.io as io;
        let _ = io.onSignal("INVALID", fn() { () });
        let x = true;
    "#;
    let analysis = analyze_without_diagnostics(source);
    let hir_result = eval_hir(&analysis);
    assert!(
        hir_result.is_err(),
        "expected error for unknown signal, got {:?}",
        hir_result
    );
    let err = hir_result.unwrap_err().to_string();
    assert!(
        err.contains("unknown signal"),
        "expected 'unknown signal' in error, got: {err}"
    );
}

#[test]
fn test_end_to_end_signal_handler_rejects_non_callable() {
    // io.onSignal with a non-callable second argument should produce an error.
    // Check both AST and HIR error paths independently.
    // The type checker will reject this, so we use analyze_source directly and
    // verify that evaluation fails on each path.
    let source = r#"
        import std.io as io;
        let _ = io.onSignal("INT", 42);
        let x = true;
    "#;
    let analysis = analyze_source(source);

    // Both AST and HIR evaluators should produce errors.
    let ast_result = eval_ast(&analysis);
    let hir_result = eval_hir(&analysis);

    assert!(
        ast_result.is_err(),
        "AST evaluator should fail for non-callable signal handler, got {:?}",
        ast_result
    );
    assert!(
        hir_result.is_err(),
        "HIR evaluator should fail for non-callable signal handler, got {:?}",
        hir_result
    );
}

#[test]
fn test_end_to_end_signal_handler_duplicate_registration() {
    // Registering the same signal twice should not crash (last registration wins).
    let source = r#"
        import std.io as io;
        let _ = io.onSignal("USR1", fn() { () });
        let _ = io.onSignal("USR1", fn() { () });
        let x = true;
    "#;
    let analysis = analyze_without_diagnostics(source);
    let hir_value = eval_hir(&analysis).expect("HIR evaluator should succeed");
    assert_eq!(hir_value, Value::Bool(true));
}

