}

#[test]
fn test_end_to_end_stream_bytes_roundtrip() {
    // Write temp file, io.streamBytes + io.streamCollect returns List<Bytes>.
    // Then verify the concatenation of collected bytes matches the original content.
    let temp = TempDir::new().expect("temp dir");
    let test_path = temp.path().join("stream-bytes-test.bin");
    let content: Vec<u8> = (0..2000u32).map(|i| (i % 256) as u8).collect();
    std::fs::write(&test_path, &content).unwrap();
    let escaped = test_path.to_string_lossy().replace('\\', "\\\\");
    assert_runtime_parity(
        &format!(
            r#"
import std.io as io;
let s = io.streamBytes("{escaped}");
let chunks = io.streamCollect(s);
let x = len(chunks) > 0;
"#
        ),
        Value::Bool(true),
    );
}

#[test]
fn test_end_to_end_stream_collect_empty() {
    // io.streamCommand on a command with no output returns empty list.
    assert_runtime_parity(
        r#"
import std.io as io;
let cmd = io.command("sh", ["-c", "exit 0"]);
let s = io.streamCommand(cmd);
let result = io.streamCollect(s);
let x = result == [];
"#,
        Value::Bool(true),
    );
}

// ============================================================
// Task cancel / awaitAny tests (Phase 4 additions)
// ============================================================

#[test]
fn test_end_to_end_task_cancel_stops_running_task() {
    // Spawn a long-running task, cancel immediately, verify cancel returns Unit.
    let source = r#"
        import std.io as io;
        let task = io.taskCommand(io.command("sleep", ["10"]));
        let id = io.spawn(task);
        let result = io.cancel(id);
        let x = result == ();
    "#;
    let analysis = analyze_without_diagnostics(source);
    let ast_value = eval_ast(&analysis).expect("AST evaluator should succeed");
    let hir_value = eval_hir(&analysis).expect("HIR evaluator should succeed");
    assert_eq!(ast_value, Value::Bool(true));
    assert_eq!(hir_value, Value::Bool(true));
}

#[test]
fn test_end_to_end_task_await_any_returns_first() {
    // Spawn two tasks (echo "fast" and sleep 10), call awaitAny, verify the fast one wins.
    let source = r#"
        import std.io as io;
        let tasks = [
            io.taskCommand(io.command("echo", ["fast"])),
            io.taskCommand(io.command("sleep", ["10"]))
        ];
        let result = io.awaitAny(tasks);
        let x = io.processSuccess(result);
    "#;
    let analysis = analyze_without_diagnostics(source);
    let ast_value = eval_ast(&analysis).expect("AST evaluator should succeed");
    let hir_value = eval_hir(&analysis).expect("HIR evaluator should succeed");
    assert_eq!(ast_value, Value::Bool(true));
    assert_eq!(hir_value, Value::Bool(true));
}

#[test]
fn test_end_to_end_task_await_any_single() {
    // awaitAny with a single task works like awaitTask.
    assert_runtime_parity(
        r#"
        import std.io as io;
        let result = io.awaitAny([
            io.taskCommand(io.command("echo", ["hello"]))
        ]);
        let x = io.processSuccess(result);
        "#,
        Value::Bool(true),
    );
}

#[test]
fn test_end_to_end_task_cancel_nonexistent_noop() {
    // Cancel a non-existent spawn ID should not error (returns Unit).
    assert_runtime_parity(
        r#"
        import std.io as io;
        let _ = io.cancel(99999);
        true
        "#,
        Value::Bool(true),
    );
}

