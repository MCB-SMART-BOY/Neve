{
  "permissions": {
    "allow": [
      "Bash(cargo:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(sed:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sort:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(which:*)",
      "Bash(chmod:*)",
      "Bash(mkdir:*)",
      "Bash(script:*)",
      "Bash(printf:*)",
      "Bash(tmux:*)",
      "Read(**/*)",
      "Glob(**/*)",
      "Grep(**/*)",
      "Edit(**/*.rs)",
      "Edit(**/*.md)",
      "Edit(**/*.toml)",
      "Edit(**/*.lean)",
      "Edit(**/*.n3v3)",
      "Edit(**/*.json)",
      "Edit(**/*.lock)",
      "Edit(**/*.yml)",
      "Edit(**/*.sh)",
      "Edit(**/*.js)",
      "Write(**/*.md)",
      "Write(**/*.rs)",
      "Write(**/*.toml)",
      "Write(**/*.json)",
      "Write(**/*.sh)",
      "Write(**/*.js)",
      "Write(**/*.lean)",
      "Write(**/*.n3v3)"
    ],
    "ask": [
      "Bash(cargo publish:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(cargo yank:*)",
      "Edit(.git/**)",
      "Edit(**/.gitignore)"
    ]
  },
  "hooks": {
    "pre-commit": {
      "command": ".claude/hooks/pre-commit.sh",
      "description": "Run pre-commit checks before git commit"
    },
    "post-edit": {
      "command": ".claude/hooks/verify-skills.sh",
      "description": "Verify skill claims after edits; docs validation wiring is owned by the hooks workflow"
    },
    "post-test": {
      "command": ".claude/hooks/check-regressions.sh",
      "description": "Check for test regressions"
    }
  },
  "rules": ".claude/rules.md",
  "env": {
    "N3V3_SKILLS_DIR": "${workspaceFolder}/.claude/skills",
    "N3V3_HOOKS_DIR": "${workspaceFolder}/.claude/hooks",
    "LEAN_PATH": "${workspaceFolder}/formal"
  },
  "model": "opus",
  "planMode": "auto",
  "worktree": {
    "baseRef": "head"
  },
  "skills": {
    "n3v3-dev": {
      "description": "n3v3 project architecture and development workflow",
      "path": ".claude/skills/n3v3-dev.md"
    },
    "n3v3-parser": {
      "description": "Lexer and recursive-descent parser development",
      "path": ".claude/skills/n3v3-parser.md"
    },
    "n3v3-typeck": {
      "description": "Hindley-Milner type inference and trait system",
      "path": ".claude/skills/n3v3-typeck.md"
    },
    "n3v3-hir": {
      "description": "HIR lowering and name resolution",
      "path": ".claude/skills/n3v3-hir.md"
    },
    "n3v3-eval": {
      "description": "Tree-walking interpreter (HIR canonical)",
      "path": ".claude/skills/n3v3-eval.md"
    },
    "n3v3-std": {
      "description": "Standard library (I/O, Stream<T>, collections)",
      "path": ".claude/skills/n3v3-std.md"
    },
    "n3v3-diagnostic": {
      "description": "Compiler diagnostic system and error reporting",
      "path": ".claude/skills/n3v3-diagnostic.md"
    },
    "n3v3-fmt": {
      "description": "n3v3 formatter and formatting validation",
      "path": ".claude/skills/n3v3-fmt.md"
    },
    "n3v3-lsp": {
      "description": "Language Server Protocol; method/notification counts from scripts/counts.sh. did_change_configuration and did_change_watched_files are accepted but stubbed (restart to apply).",
      "path": ".claude/skills/n3v3-lsp.md"
    },
    "n3v3-test": {
      "description": "Testing strategy; E2E and other counts from scripts/counts.sh",
      "path": ".claude/skills/n3v3-test.md"
    },
    "n3v3-effect": {
      "description": "Effect system (EffectEval v4.3, 34 rules)",
      "path": ".claude/skills/n3v3-effect.md"
    },
    "n3v3-lean": {
      "description": "Formal verification with Lean 4 (21 modules)",
      "path": ".claude/skills/n3v3-lean.md"
    },
    "run-n3v3": {
      "description": "Canonical n3v3 CLI smoke-test driver",
      "path": ".claude/skills/run-n3v3/SKILL.md"
    }
  },
  "agents": {
    "n3v3-parser-dev": {
      "description": "Specialized agent for parser/lexer/syntax development",
      "path": ".claude/agents/parser-agent.md"
    },
    "n3v3-typeck-dev": {
      "description": "Specialized agent for type system development",
      "path": ".claude/agents/typeck-agent.md"
    },
    "n3v3-reviewer": {
      "description": "Code review agent for n3v3 Rust codebase",
      "path": ".claude/agents/reviewer-agent.md"
    },
    "n3v3-verifier": {
      "description": "Formal verification agent for Lean proofs",
      "path": ".claude/agents/verifier-agent.md"
    }
  },
  "workflows": {
    "full-test": {
      "description": "Run scripts/validate.sh --ci and mechanically verify canonical counts",
      "path": ".claude/workflows/full-test.js"
    },
    "pre-release": {
      "description": "Run scripts/validate.sh --release with version and changelog checks",
      "path": ".claude/workflows/pre-release.js"
    }
  }
}
